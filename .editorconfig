root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
# trim_trailing_whitespace = true
# insert_final_newline = true

[*.{c,h,cpp,hpp}]
indent_style = tab

[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 2

[*.{y{a,}ml,json}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[{.vimrc,*.vim}]
indent_style = space
indent_size = 2

[{dictsource,phsource}/**/*]
trim_trailing_whitespace = false
insert_final_newline = false
